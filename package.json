{
  "name": "i-saw-it-somewhere",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "tsx --env-file-if-exists=.env.local scripts/preflight.ts --consent",
    "preflight": "tsx --env-file-if-exists=.env.local scripts/preflight.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "test:retrieval": "tsx --env-file-if-exists=.env.local scripts/evaluate.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@elastic/elasticsearch": "9.2.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "csv-parse": "7.0.3",
    "ipaddr.js": "2.5.0",
    "jsdom": "26.1.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "3.0.1",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "3.2.7"
  }
}
